# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token). Niemals teilen oder committen!
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
CLIENT_ID=
# ID deines Discord-Servers (Rechtsklick auf Server -> Server-ID kopieren, Entwicklermodus nötig).
# Ist sie gesetzt, arbeitet der Bot nur auf diesem Server. Leer lassen = alle Server, auf denen der Bot ist.
GUILD_ID=
# Optional: debug, info, warn oder error (Standard: info)
LOG_LEVEL=info
